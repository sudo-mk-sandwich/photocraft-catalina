+/// `CGPreflightScreenCaptureAccess` and `CGRequestScreenCaptureAccess` were added in macOS 11;
+/// calling them on macOS 10.15 aborts. There the system asks for the permission itself when the
+/// screen is first read, so the check is skipped.
+#[cfg(target_os = "macos")]
+fn screen_capture_access_api_exists() -> bool {
+    let Ok(out) = std::process::Command::new("/usr/bin/sw_vers").arg("-productVersion").output() else {
+        return true;
+    };
+    let text = String::from_utf8_lossy(&out.stdout);
+    let mut parts = text.trim().split('.').map(|p| p.parse::<u32>().ok());
+    match (parts.next().flatten(), parts.next().flatten()) {
+        // Big Sur reports itself as 10.16 to binaries built against an older SDK.
+        (Some(10), Some(minor)) => minor >= 16,
+        _ => true,
+    }
+}
